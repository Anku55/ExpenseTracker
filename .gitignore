# VS Code: ignore machine/user-specific workspace settings,
# but allow shared tasks, launch configs, and recommended extensions if desired.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local expense records can contain personal financial data.
expenses.txt
expenses.backup.txt

expenses.local-backup.txt
